# Chave da API Groq (obrigatória para deploy na nuvem)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Modelo Groq (opcional - padrão: llama-3.3-70b-versatile)
# Respostas mais naturais: llama-3.3-70b-versatile
# Mais rápido/barato: llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local
# Se USE_OLLAMA=1, habilita Ollama explicitamente.
# Se USE_OLLAMA não for definido e GROQ_API_KEY estiver ausente, o servidor ativa
# fallback automático para Ollama.
# USE_OLLAMA=1
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:1b
