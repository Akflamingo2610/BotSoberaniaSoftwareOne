# Banco (PostgreSQL)
POSTGRES_USER=bot_soberania
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=bot_soberania

# API
DATABASE_URL=postgresql+psycopg2://bot_soberania:troque_esta_senha@localhost:5432/bot_soberania
AUTO_CREATE_SCHEMA=0
TOKEN_TTL_MINUTES=1440
PASSWORD_MIN_LENGTH=8
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_ATTEMPTS=15
ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
